# NexaVault Environment Variable Template
# Copy to .env and set actual production values before deployment.
# NEVER commit real secrets to source control.

# PostgreSQL Connection String (Use external managed PostgreSQL instance for production)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>

# Secret key for signing JWT tokens (Minimum 32 random characters recommended)
JWT_SECRET=your_production_secret_key_32_characters_minimum

# JSON array of permitted CORS origins
CORS_ORIGINS=["https://yourdomain.com","http://localhost:3000"]

# Optional overrides for local development database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexavault_db
